{
    log {
        output discard
    }
}

# ==============================================================================
# SYNAPSE-MESH ZERO-PII / ZERO-LOG CADDY CONFIGURATION (GDPR / DSGVO COMPLIANT)
# ==============================================================================
# 1. No IP addresses are stored on disk (log output discard).
# 2. Strict TLS 1.3 + HSTS 1-Year Preload.
# 3. Anonymized loopback headers for internal upstream proxies.
# ==============================================================================

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }
}

(zero_log) {
    log {
        output discard
    }
}

# Explicit drop for direct IP access and scanner bots
http://217.160.170.209, https://217.160.170.209 {
    import zero_log
    respond "Access Denied: Use official domain name" 403 {
        close
    }
}

synapsemesh.dev, www.synapsemesh.dev, api.synapsemesh.dev, status.synapsemesh.dev {
    import security_headers
    import zero_log
    encode zstd gzip

    # Reverse proxy with zero IP forwarding
    reverse_proxy api:8000 {
        header_up Host {host}
        header_up X-Real-IP "127.0.0.1"
        header_up X-Forwarded-For "127.0.0.1"
        header_up X-Forwarded-Proto {scheme}
    }
}

mcp.synapsemesh.dev {
    import security_headers
    import zero_log
    encode zstd gzip

    rewrite / /mcp

    reverse_proxy api:8000 {
        header_up Host {host}
        header_up X-Real-IP "127.0.0.1"
        header_up X-Forwarded-For "127.0.0.1"
        header_up X-Forwarded-Proto {scheme}
    }
}

docs.synapsemesh.dev {
    import security_headers
    import zero_log
    encode zstd gzip

    rewrite / /docs

    reverse_proxy api:8000 {
        header_up Host {host}
        header_up X-Real-IP "127.0.0.1"
        header_up X-Forwarded-For "127.0.0.1"
        header_up X-Forwarded-Proto {scheme}
    }
}
