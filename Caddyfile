{
	skip_install_trust

	log {
		output discard
	}
}

# ==============================================================================
# SYNAPSE-MESH DATA-MINIMISING EDGE CONFIGURATION
# ==============================================================================
# 1. No IP addresses are stored on disk (log output discard).
# 2. Caddy-managed TLS with HSTS 1-Year Preload.
# 3. Loopback-only client address headers for the internal upstream.
# ==============================================================================

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

(zero_log) {
	log {
		output discard
	}
}

# Explicit drop for direct IP access and scanner bots (IPv4 & IPv6)
http://217.160.170.209, https://217.160.170.209, http://[2a02:2479:106:c700::1], https://[2a02:2479:106:c700::1] {
	import zero_log
	respond "Access Denied: Use official domain name" 403 {
		close
	}
}

synapsemesh.dev, www.synapsemesh.dev, api.synapsemesh.dev, status.synapsemesh.dev {
	import security_headers
	import zero_log
	encode zstd gzip

	# Reverse proxy with zero IP forwarding
	reverse_proxy api:8000 {
		header_up Host {host}
		header_up X-Real-IP "127.0.0.1"
		header_up X-Forwarded-For "127.0.0.1"
		header_up -Forwarded
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
		header_up -X-Client-IP
		header_up -X-Cluster-Client-IP
	}
}

mcp.synapsemesh.dev {
	import security_headers
	import zero_log
	encode zstd gzip

	rewrite / /mcp

	reverse_proxy api:8000 {
		header_up Host {host}
		header_up X-Real-IP "127.0.0.1"
		header_up X-Forwarded-For "127.0.0.1"
		header_up -Forwarded
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
		header_up -X-Client-IP
		header_up -X-Cluster-Client-IP
	}
}

docs.synapsemesh.dev {
	import security_headers
	import zero_log
	encode zstd gzip

	rewrite / /docs

	reverse_proxy api:8000 {
		header_up Host {host}
		header_up X-Real-IP "127.0.0.1"
		header_up X-Forwarded-For "127.0.0.1"
		header_up -Forwarded
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
		header_up -X-Client-IP
		header_up -X-Cluster-Client-IP
	}
}
