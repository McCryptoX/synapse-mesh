# ==============================================================================
# Synapse-Mesh Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust the values for your environment.
# Never commit real secrets or production .env files to source control.

# --- Application Core Settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Synapse-Mesh (Exocortex)
APP_VERSION=0.1.0-beta
DOMAIN=localhost
BASE_URL=http://localhost:8000
CANONICAL_MCP_URL=http://localhost:8000/mcp
AUTONOMOUS_MINING_ENABLED=true

# --- Database Storage ---
# Relative path from project root or absolute path in container
DB_PATH=data/synapse_mesh.sqlite3

# --- Authentication & Access Control ---
# ADMIN_TOKEN: Secret key for programmatic administrative API endpoints (X-Synapse-Admin-Key)
# Required in production; empty token disables administrative write routes.
ADMIN_TOKEN=replace-with-a-strong-random-admin-secret-key

# OPS_PASSWORD: Initial bootstrap password for the private /ops web dashboard.
# Once used to log in, a salted PBKDF2-SHA256 hash is saved to SQLite, and this
# fallback is automatically disabled in favor of the persisted hash.
OPS_PASSWORD=replace-with-a-strong-random-ops-password

# --- Upstream Miner / Harvester (Optional) ---
# Optional GitHub token for changelog crawler rate limits.
# If omitted, github_harvester.py falls back to public rate-limit-free Atom feeds.
GITHUB_TOKEN=

# --- Deployment / First-Time Boot (Production Only) ---
# Set to 1 only when initializing a brand new server deployment without an existing database.
# SYNAPSE_ALLOW_EMPTY_DATABASE=0
